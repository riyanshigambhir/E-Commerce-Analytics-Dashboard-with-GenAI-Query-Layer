## Copy this file to .env and fill in your key to unlock LLM mode.
## Without it, the app runs fine in fallback (pattern-matched) mode.
##
## Only ONE of these is needed. If OPENAI_API_KEY is set, it's used;
## otherwise ANTHROPIC_API_KEY is used if present.

OPENAI_API_KEY=sk-...

# ANTHROPIC_API_KEY=sk-ant-...
